          </div>
        </section>

        <!-- Section 2: Arena Background Theme -->
        <section class="bg-stone-950/80 border border-white/10 rounded-xl p-4">
          <h3 class="text-lg font-bold text-amber-400 mb-3 flex items-center gap-2">
            <span>🖼️</span> arena background theme
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
            <button class="bg-preset-btn p-2 rounded-xl border-2 border-transparent hover:border-amber-400 bg-stone-800 text-xs font-bold text-center transition" data-bg="gradient-purple">
              <div class="h-12 rounded-lg bg-gradient-to-b from-indigo-950 to-stone-950 mb-1"></div>
              midnight dojo
            </button>
            <button class="bg-preset-btn p-2 rounded-xl border-2 border-transparent hover:border-amber-400 bg-stone-800 text-xs font-bold text-center transition" data-bg="gradient-bamboo">
              <div class="h-12 rounded-lg bg-gradient-to-b from-emerald-950 to-stone-950 mb-1"></div>
              bamboo garden
            </button>
            <button class="bg-preset-btn p-2 rounded-xl border-2 border-transparent hover:border-amber-400 bg-stone-800 text-xs font-bold text-center transition" data-bg="gradient-sunset">
              <div class="h-12 rounded-lg bg-gradient-to-b from-orange-950 to-stone-950 mb-1"></div>
              sunset orchard
            </button>
            <button class="bg-preset-btn p-2 rounded-xl border-2 border-transparent hover:border-amber-400 bg-stone-800 text-xs font-bold text-center transition" data-bg="gradient-dojowood">
              <div class="h-12 rounded-lg bg-gradient-to-b from-amber-950 to-stone-950 mb-1"></div>
              wood floor
            </button>
          </div>
          <div class="flex flex-col sm:flex-row gap-2">
            <input id="customBgUrlInput" type="text" placeholder="Or paste background image URL..." 
                   class="flex-1 bg-stone-900 border border-white/20 rounded-xl px-3 py-2 text-stone-200 text-xs focus:ring-1 focus:ring-amber-400 outline-none" />
            <button id="btnApplyBgUrl" class="px-4 py-2 bg-amber-600 hover:bg-amber-500 rounded-xl font-bold text-white text-xs">apply url</button>
            <label class="px-4 py-2 bg-stone-800 hover:bg-stone-700 rounded-xl font-bold text-stone-300 text-xs cursor-pointer text-center">
              upload file
              <input id="bgFileInput" type="file" accept="image/*" class="hidden">
            </label>
          </div>
        </section>

        <!-- Section 3: Fruits & Transparent Pictures Manager -->
        <section class="bg-stone-950/80 border border-white/10 rounded-xl p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg font-bold text-amber-400 flex items-center gap-2">
              <span>🍍</span> fruit pictures (transparent background) & custom upload
            </h3>
            <button id="btnResetFruitWords" class="text-xs text-rose-400 hover:underline">reset default pictures</button>
          </div>
          <p class="text-xs text-stone-400 mb-3">
            upload transparent PNG images or paste transparent image URLs for each fruit. Transparent backgrounds ensure pure juicy slice action!
          </p>

          <div id="wordListGrid" class="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-64 overflow-y-auto pr-1">
            <!-- Populated via script -->
          </div>
        </section>

        <!-- Section 4: Tray Customization -->
        <section class="bg-stone-950/80 border border-white/10 rounded-xl p-4 mt-4">
          <h3 class="text-lg font-bold text-amber-400 mb-2 flex items-center gap-2">
            <span>🧺</span> custom fruit tray / basket image
          </h3>
          <p class="text-xs text-stone-400 mb-3">
            paste an image url to override the default wooden tray background in counting rounds.
          </p>
          <input id="customTrayUrlInput" type="text" placeholder="paste tray image url..." class="w-full bg-stone-900 border border-white/20 rounded-xl px-3 py-2 text-stone-200 text-xs focus:ring-1 focus:ring-amber-400 outline-none" />
        </section>

        <!-- Section 5: Announcer & Volumes -->
        <section class="bg-stone-950/80 border border-white/10 rounded-xl p-4">
          <h3 class="text-lg font-bold text-amber-400 mb-3 flex items-center gap-2">
            <span>🎙️️</span> wrestling announcer & audio controls
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-3">
            <div>
              <label class="block text-xs font-bold text-stone-300 mb-1">bubbly fruit music volume</label>
              <input id="sliderMusicVol" type="range" min="0" max="1" step="0.05" value="0.35" class="w-full accent-amber-400">
            </div>
            <div>
              <label class="block text-xs font-bold text-stone-300 mb-1">juicy slice & bomb volume</label>
              <input id="sliderSfxVol" type="range" min="0" max="1" step="0.05" value="0.75" class="w-full accent-amber-400">
            </div>
          </div>
          <button id="btnTestVoice" class="px-4 py-2 bg-stone-800 hover:bg-stone-700 border border-amber-400/40 rounded-xl text-amber-300 text-xs font-bold flex items-center gap-2">
            <span>📢</span> test announcer voice ("round 1! spell apple! fight!")
          </button>
        </section>

      </div>

      <div class="p-3 bg-stone-950 border-t border-amber-500/30 flex justify-end gap-3">
        <button id="btnSaveDashboard" class="px-6 py-2 bg-gradient-to-r from-amber-500 to-red-600 hover:brightness-110 text-white font-bold text-lg rounded-xl shadow-lg">
          save all settings
        </button>
      </div>
    </div>
  </div>

  <script>
    /**
     * THE 20 GAME ROUND QUESTIONS
     */
    const ROUND_QUESTIONS = [
      { round: 1, type: 'spell', word: 'apple', prompt: "spell 'apple'", fruitKey: 'apple' },
      { round: 2, type: 'spell', word: 'pineapple', prompt: "spell 'pineapple'", fruitKey: 'pineapple' },
      { round: 3, type: 'spell', word: 'papayas', prompt: "spell 'papayas'", fruitKey: 'papayas' },
      { round: 4, type: 'spell', word: 'bananas', prompt: "spell 'bananas'", fruitKey: 'bananas' },
