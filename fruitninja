    </div>

    <!-- MOBILE CONTROLS ROW -->
    <div class="absolute bottom-2 left-1/2 transform -translate-x-1/2 z-40 flex items-center gap-4 sm:hidden pointer-events-auto">
      <button id="btnPauseGameMob" class="bg-blue-600 hover:bg-blue-500 border-2 border-blue-400/50 text-white font-bold rounded-xl px-4 py-2 shadow-lg text-sm transition active:scale-95">pause</button>
      <button id="btnEndGameMob" class="bg-red-600 hover:bg-red-500 border-2 border-red-400/50 text-white font-bold rounded-xl px-4 py-2 shadow-lg text-sm transition active:scale-95">end</button>
    </div>

    <div id="pauseOverlay" class="hidden absolute inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm pointer-events-none">
       <div class="text-5xl sm:text-7xl font-bold text-yellow-300 drop-shadow-[0_0_20px_rgba(234,179,8,0.8)] animate-pulse">paused</div>
    </div>

    <div class="relative w-full h-full flex flex-row overflow-hidden">

      <!-- FULL SCREEN CONTAINER: SOLO PLAYER -->
      <div id="p1Container" class="relative flex-1 h-full overflow-hidden">
        
        <!-- HUD Header -->
        <div class="absolute top-2 left-2 right-2 z-20 flex flex-col gap-1.5 pointer-events-none">
          <div class="flex items-center justify-between bg-black/65 backdrop-blur-md rounded-2xl px-4 py-1.5 border border-rose-500/50 shadow-lg">
            <div class="flex items-center gap-2 truncate">
              <span class="text-lg">🦫</span>
              <span id="hudP1Name" class="text-rose-300 text-sm sm:text-base font-bold truncate max-w-[150px]">group 1</span>
            </div>
            <!-- 3 Hearts -->
            <div id="hudP1Lives" class="flex gap-1 text-lg">
              <span>❤️</span><span>❤️</span><span>❤️</span>
            </div>
            <!-- Total Score Display -->
            <div class="text-amber-300 text-sm sm:text-base font-bold">
              total score: <span id="hudP1MatchScore">0</span>
            </div>
          </div>

          <!-- Challenge Target Status: Spelling slots OR Counting Progress -->
          <div class="flex items-center justify-center gap-2 bg-black/55 backdrop-blur-md py-1 px-3 rounded-2xl border border-white/10 shadow-md">
            <span id="hudP1GoalLabel" class="text-xs text-amber-400 font-bold">spell:</span>
            <div id="hudP1Slots" class="flex gap-1 flex-wrap justify-center items-center">
              <!-- Dynamically populated -->
            </div>
          </div>
        </div>

        <!-- Canvas for Solo Player -->
        <canvas id="canvasP1" class="absolute inset-0 w-full h-full"></canvas>
      </div>

    </div>
  </div>

  <!-- SCREEN 5: ROUND RESULT / SCORE DISPLAY MODAL -->
  <div id="screenWinner" class="hidden absolute inset-0 z-50 flex flex-col items-center justify-center p-4 bg-black/85 backdrop-blur-lg">
    <div class="max-w-md w-full bg-stone-900 border-4 border-amber-400 rounded-3xl p-6 text-center shadow-[0_0_60px_rgba(245,158,11,0.6)]">
      <div class="text-5xl mb-2 animate-bounce">🏆</div>
      <h2 id="winnerTitle" class="text-3xl sm:text-4xl font-bold text-yellow-300 tracking-wider mb-1">round complete!</h2>
      <p id="winnerMessage" class="text-base text-rose-300 mb-4">great job!</p>

      <div class="bg-black/55 rounded-2xl p-4 mb-5 border border-white/10 flex flex-col items-center justify-center gap-1">
        <div id="winP1Name" class="text-sm font-bold text-amber-400 truncate">group 1</div>
        <div class="text-xs text-stone-400">your score for this round:</div>
        <div id="winRoundPoints" class="text-4xl font-black text-green-400 mb-1">+1 pt</div>
        <div class="text-xs text-stone-400">total overall score:</div>
        <div id="winP1Score" class="text-3xl font-bold text-white">0</div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <button id="btnNextMatchRandomizer" class="px-6 py-2.5 bg-gradient-to-r from-amber-500 to-red-600 hover:brightness-110 font-bold text-xl text-white rounded-xl shadow-lg active:scale-95 transition flex items-center justify-center gap-2">
          <span>➡️</span> next round 
        </button>
        <button id="btnBackToMenu" class="px-4 py-2.5 bg-stone-800 hover:bg-stone-700 font-bold text-lg text-stone-300 rounded-xl shadow-lg active:scale-95 transition">
          menu 🏠
        </button>
      </div>
    </div>
  </div>

  <!-- SCREEN 6: TEACHER CONTROL DASHBOARD (Retains image upload functionality) -->
  <div id="modalDashboard" class="hidden fixed inset-0 z-50 flex items-center justify-center p-3 bg-black/85 backdrop-blur-md overflow-y-auto">
    <div class="bg-stone-900 border-2 border-amber-400 rounded-2xl w-full max-w-4xl max-h-[92vh] flex flex-col shadow-2xl overflow-hidden text-stone-200">
      
      <div class="p-4 bg-gradient-to-r from-red-950 via-stone-900 to-amber-950 border-b border-amber-500/30 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-2xl">⚙️</span>
          <h2 class="text-2xl font-bold tracking-wider text-amber-300">teacher control dashboard</h2>
        </div>
        <button id="btnCloseDashboard" class="text-stone-400 hover:text-white text-3xl font-bold px-2 py-0">&times;</button>
      </div>

      <div class="p-5 overflow-y-auto space-y-6 flex-1 text-sm">
        
        <!-- Section 1: Questions & Rounds List -->
        <section class="bg-stone-950/80 border border-white/10 rounded-xl p-4">
          <h3 class="text-lg font-bold text-amber-400 mb-2 flex items-center gap-2">
            <span>📜</span> 20 game rounds overview (spelling, counting, listening)
          </h3>
          <p class="text-xs text-stone-400 mb-3">
            rounds 1-7: spelling. rounds 8-15: counting trays. rounds 16-20: listen & spell challenges.
          </p>
          <div id="dashboardRoundsList" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs max-h-48 overflow-y-auto pr-1">
