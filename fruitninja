      <button id="btnStartGame" class="px-10 py-3.5 rounded-full text-2xl sm:text-3xl font-bold text-amber-950 bg-gradient-to-b from-yellow-300 via-amber-400 to-orange-500 hover:from-yellow-200 hover:to-orange-400 shadow-[0_0_35px_rgba(245,158,11,0.7)] transition transform hover:scale-105 active:scale-95 border-4 border-yellow-200">
