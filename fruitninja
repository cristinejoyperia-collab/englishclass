<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>FRUIT SPELL - Solo Game</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * {
      touch-action: none;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
      box-sizing: border-box;
      text-transform: lowercase !important;
    }
    body, html {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: #09090b;
      color: #fff;
    }

    /* Font Styles applied specifically to Game Screens */
    .comic-sans-font,
    .comic-sans-font * {
      font-family: 'Comic Sans MS', 'Comic Sans', cursive, sans-serif !important;
    }

    /* Blade sheen effect */
    @keyframes sheen {
      0% { transform: translateX(-150%) skewX(-25deg); }
      100% { transform: translateX(250%) skewX(-25deg); }
    }
    .blade-sheen::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.7) 50%, rgba(255,255,255,0) 100%);
      animation: sheen 2.8s infinite;
      pointer-events: none;
    }

    /* Screen Shake on Bomb */
    .shake {
      animation: shake 0.45s cubic-bezier(.36,.07,.19,.97) both;
    }
    @keyframes shake {
      10%, 90% { transform: translate3d(-5px, 0, 0); }
      20%, 80% { transform: translate3d(6px, 0, 0); }
      30%, 50%, 70% { transform: translate3d(-8px, 0, 0); }
      40%, 60% { transform: translate3d(8px, 0, 0); }
    }

    /* Wooden tray texture */
    .wooden-tray {
      background: radial-gradient(circle, #b45309 0%, #78350f 100%);
      border: 6px solid #451a03;
      box-shadow: inset 0 0 25px rgba(0,0,0,0.7), 0 10px 25px rgba(0,0,0,0.6);
    }

    /* Checkerboard for transparent image preview */
    .checkerboard {
      background-color: #1e1b4b;
      background-image: linear-gradient(45deg, #111827 25%, transparent 25%), 
                        linear-gradient(-45deg, #111827 25%, transparent 25%), 
                        linear-gradient(45deg, transparent 75%, #111827 75%), 
                        linear-gradient(-45deg, transparent 75%, #111827 75%);
      background-size: 16px 16px;
      background-position: 0 0, 0 8px, 8px -8px, -8px 0px;
    }
  </style>
</head>
<body class="relative w-full h-full select-none bg-stone-950 overflow-hidden">

  <!-- DYNAMIC BACKGROUND LAYER -->
  <div id="gameBgLayer" class="absolute inset-0 z-0 bg-cover bg-center transition-all duration-700" 
       style="background-image: radial-gradient(circle at center, #2e1065 0%, #09090b 100%);">
  </div>
  <div id="gameBgOverlay" class="absolute inset-0 z-0 opacity-25 bg-[radial-gradient(#ffffff_1.5px,transparent_1.5px)] [background-size:24px_24px] pointer-events-none"></div>

  <!-- TOP UTILITY BAR -->
  <header class="absolute top-2.5 right-3 z-50 flex items-center gap-2">
    <button id="btnSoundToggle" class="px-3 py-1 bg-black/60 hover:bg-black/85 text-amber-300 rounded-full border border-amber-400/40 text-xs sm:text-sm font-bold flex items-center gap-1.5 shadow-lg active:scale-95 transition">
      <span id="soundIcon">🔊</span> <span id="soundLabel" class="hidden sm:inline">sound on</span>
    </button>
    <button id="btnOpenDashboard" class="px-3.5 py-1.5 bg-gradient-to-r from-red-600 via-amber-600 to-yellow-600 hover:brightness-110 text-white rounded-full font-bold text-xs sm:text-sm shadow-xl flex items-center gap-1.5 border border-amber-300/40 active:scale-95 transition">
      <span>⚙️</span> <span class="hidden sm:inline">teacher dashboard</span>
    </button>
  </header>

  <!-- SCREEN 1: TITLE SCREEN (Retains default title styling) -->
  <div id="screenTitle" class="absolute inset-0 z-40 flex flex-col items-center justify-center p-4 bg-black/75 backdrop-blur-sm">
    <div class="max-w-2xl w-full text-center flex flex-col items-center">
      
