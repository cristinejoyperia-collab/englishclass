        <h2 class="text-xl sm:text-2xl text-amber-300 tracking-widest drop-shadow-md">
          ⚔️ solo ninja battle ⚔️
        </h2>
        <h1 class="text-5xl sm:text-7xl font-black text-transparent bg-clip-text bg-gradient-to-b from-yellow-300 via-orange-400 to-red-600 drop-shadow-[0_12px_28px_rgba(239,68,68,0.7)] transform -rotate-1">
          fruit ninja spell!
        </h1>
        <div class="h-1.5 w-full bg-gradient-to-r from-transparent via-amber-400 to-transparent mt-2"></div>
      </div>

      <div class="flex gap-3 sm:gap-4 justify-center text-4xl sm:text-5xl mb-5 animate-bounce">
        <span>🍎</span><span>🍍</span><span>🥭</span><span>🍌</span><span>🍊</span><span>🍇</span><span>🍈</span>
      </div>

      <div class="w-full max-w-lg bg-stone-900/90 border-2 border-amber-400/50 rounded-2xl p-4 shadow-2xl backdrop-blur-md mb-5 text-stone-200">
